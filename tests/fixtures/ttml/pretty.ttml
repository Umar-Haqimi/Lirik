<?xml version="1.0" encoding="UTF-8"?>
<!-- pretty printed, indented, with comments -->
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xml:lang="en">
  <head>
    <metadata>
      <ttm:agent type="person" xml:id="v1"/>
    </metadata>
  </head>
  <body dur="1:00.000">
    <div>
      <p begin="1.000" end="3.000" ttm:agent="v1">
        <span begin="1.000" end="1.500">pla</span><span begin="1.500" end="2.000">ce</span>
        <span begin="2.000" end="3.000">holder</span>
      </p>
      <p begin="4.000" end="6.000">
        a line
        across two rows
      </p>
    </div>
  </body>
</tt>
