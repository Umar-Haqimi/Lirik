<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xml:lang="en"><head><metadata><ttm:agent type="person" xml:id="p1"><ttm:name>Singer A</ttm:name></ttm:agent><ttm:agent type="character" xml:id="p2"><ttm:name>Singer B</ttm:name></ttm:agent><ttm:agent type="group" xml:id="g1"><ttm:name>Both</ttm:name></ttm:agent></metadata></head><body><div><p begin="1.000" end="2.000" ttm:agent="p1"><span begin="1.000" end="2.000">first</span></p><p begin="2.000" end="3.000" ttm:agent="p2"><span begin="2.000" end="3.000">second</span></p><p begin="3.000" end="4.000" ttm:agent="g1"><span begin="3.000" end="4.000">together</span></p></div></body></tt>
